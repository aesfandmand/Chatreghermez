    "/services/",
    "/products/",
    "/printing/",
    "/solutions/",
    "/portfolio/",
    "/projects/",
    "/capabilities/",
    "/facilities/",
    "/blog/",
    "/video/",
    "/about-us/",
    "/credentials/",
    "/consulting/",
    "/contact-us/",
    "/faq/",
    "/privacy/",
    "/terms/"
  ],
  "commerce_routes": [
    {
      "route": "/products/",
      "index": "Index",
      "active_phase": 1
    },
    {
      "route": "/products/{family}/{product}/",
      "index": "Index when complete",
      "active_phase": 1
    },
    {
      "route": "/cart/",
      "index": "Noindex",
      "active_phase": 1
    },
    {
      "route": "/checkout/",
      "index": "Noindex",
      "active_phase": 1
    },
    {
      "route": "/account/",
      "index": "Noindex",
      "active_phase": 1
    },
    {
      "route": "/account/orders/",
      "index": "Noindex",
      "active_phase": 1
    },
    {
