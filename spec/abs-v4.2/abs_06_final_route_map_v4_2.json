    "/wp-json/chatreghermez/v1/content/*",
    "/wp-json/chatreghermez/v1/catalog/*",
    "/wp-json/chatreghermez/v1/cart/*",
    "/wp-json/chatreghermez/v1/orders/*",
    "/wp-json/chatreghermez/v1/features/*",
    "/wp-json/chatreghermez/v1/rental/* (registered only by future module)"
  ],
  "reserved_namespaces": [
    "media-rental",
    "cart",
    "checkout",
    "account",
    "orders",
    "printing",
    "video",
    "catalog",
    "downloads"
