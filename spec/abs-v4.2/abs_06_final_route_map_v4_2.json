{
  "version": "v4.2-FINAL-LOCKED",
  "status": "authoritative final logical route contract; route-root integrity hotfix",
  "rules": {
    "trailing_slash": true,
    "lowercase_english_slugs": true,
    "public_route_changes_require_redirect": true,
    "system_pages_noindex": true,
    "filter_parameters_noindex": true,
    "rental_routes_hidden_until_feature_flag": true,
